#!/bin/sh
# save-credentials <username>   (credentials JSON read from stdin)
# Writes /sepal/home/<username>/.config/earthengine/credentials owned root:<gid-of-data-home>,
# mirroring the Java GoogleAccessTokenFileGateway. Runs as root via sudo (node stays non-root).
# The user controls everything under their data home, so every directory is entered and checked to
# resolve inside it, and all later operations are relative to that pinned working directory.
set -e

username="$1"
case "$username" in
    "" | *[!A-Za-z0-9_]* ) echo "invalid username: $username" >&2; exit 2 ;;
esac

data_home="/sepal/home/$username"
[ -d "$data_home" ] || { echo "no data home for $username" >&2; exit 3; }
gid=$(stat -c '%g' "$data_home")
cd -P "$data_home"
home=$(pwd -P)

enter() {
    mkdir -p "$1"
    cd -P "$1"
    case "$(pwd -P)" in
        "$home"/*) ;;
        *) echo "$1 resolves outside the data home of $username" >&2; exit 4 ;;
    esac
    chown "root:$gid" .; chmod 1777 .
}

enter .config
enter earthengine

umask 022
tmp=".credentials.$$"
rm -f "$tmp"
(set -C; cat > "$tmp")             # stdin -> new file; noclobber refuses to follow a planted symlink
chown -h "root:$gid" "$tmp"
mv -fT "$tmp" credentials          # replaces whatever entry is there instead of writing through it

[ -e .lock ] || [ -L .lock ] || (set -C; : > .lock)
chown -h "root:$gid" .lock
