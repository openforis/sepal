#!/bin/sh
# delete-credentials <username>
# Removes the user's Earth Engine credentials file. Runs as root via sudo.
# The user controls their data home, so the directory is checked to resolve inside it before removing.
set -e

username="$1"
case "$username" in
    "" | *[!A-Za-z0-9_]* ) echo "invalid username: $username" >&2; exit 2 ;;
esac

data_home="/sepal/home/$username"
cd -P "$data_home" 2>/dev/null || exit 0
home=$(pwd -P)
cd -P .config/earthengine 2>/dev/null || exit 0
case "$(pwd -P)" in
    "$home"/*) ;;
    *) echo ".config/earthengine resolves outside the data home of $username" >&2; exit 4 ;;
esac
rm -f credentials
