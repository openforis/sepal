#!/bin/sh
# PAM pam_exec auth: PAM_USER = username, password on stdin (expose_authtok).
# POSTs to the user module's /auth/password; exit 0 on HTTP 200 (authenticated), 1 otherwise.
set -eu

user_url="${USER_URL:-http://user}"
[ -n "${PAM_USER:-}" ] || exit 1

password=$(cat)
code=$(curl -s -o /dev/null -w '%{http_code}' \
    --max-time 10 \
    -X POST \
    --data-urlencode "username=${PAM_USER}" \
    --data-urlencode "password=${password}" \
    "${user_url}/auth/password" || echo 000)

[ "${code}" = "200" ] || exit 1
exit 0
