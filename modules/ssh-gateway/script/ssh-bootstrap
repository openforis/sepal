#!/usr/bin/env bash
interactive="non-interactive"
if [ -z "$SSH_ORIGINAL_COMMAND" ]; then
    interactive="interactive"
fi
sshScriptFile=$(mktemp /tmp/$USER-ssh.XXXXXX) > /dev/null 2>&1
chmod +x $sshScriptFile
cd /usr/local/src/sepal/modules/ssh-gateway
node src/main.js \
    --${interactive} \
    --username="${USER}" \
    --user-key-file="/home/${USER}/.ssh/id_rsa" \
    --endpoint="http://worker/" \
    --endpoint-password="$(cat /etc/sepalAdmin.passwd)" \
    --ssh-command-path="${sshScriptFile}"

if [ -s $sshScriptFile ]; then
  sessionId=$(sed -n 's/^[[:space:]]*# session-id: //p' $sshScriptFile)
  n=0
  terminated=
  until [ "$n" -ge 5 ]
  do
    eval "$sshScriptFile \"${SSH_ORIGINAL_COMMAND:-}\"" && break
    # Retrying is only worth it while the session still exists (transient drop) — once it
    # has been stopped the worker answers 404 and each retry just keeps the user staring
    # at a dead terminal. A bodiless heartbeat: this is a liveness PROBE, fired while the user
    # is disconnected, and it deliberately extends nothing. curl failure (000) keeps retrying.
    if [ -n "$sessionId" ]; then
      sessionStatus=$(curl -s -o /dev/null -w '%{http_code}' \
        -H "sepal-user:{\"username\": \"sepalAdmin\", \"roles\": [\"application_admin\"]}" \
        -X POST "http://worker/sessions/$USER/session/$sessionId")
      if [ "$sessionStatus" = "404" ]; then
        terminated=1
        break
      fi
    fi
    n=$((n+1))
    sleep 5
  done
  rm $sshScriptFile > /dev/null 2>&1
  # The session is gone for good. Returning now would hand back to the caller, which clears the
  # screen before showing the menu again — so hold here with everything the user had on screen
  # still on screen, and let them decide when to lose it. Interactive only: a non-interactive
  # ssh has nobody to press the key.
  if [ -n "$terminated" ] && [ -z "$SSH_ORIGINAL_COMMAND" ]; then
    printf '\nThe session has been terminated - press ENTER to reset the terminal'
    read -r _
  fi
fi
