{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "IssueUserCredentials",
            "Effect": "Allow",
            "Action": ["sts:AssumeRole", "sts:TagSession"],
            "Resource": "arn:aws:iam::{{ caller.account }}:role/{{ identity }}"
        },
        {
            "Sid": "ManageBucket",
            "Effect": "Allow",
            "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
            "Resource": "arn:aws:s3:::{{ bucket }}"
        },
        {
            "Sid": "ManageUserObjects",
            "Effect": "Allow",
            "Action": ["s3:GetObject", "s3:DeleteObject"],
            "Resource": "arn:aws:s3:::{{ bucket }}/users/*"
        }
    ]
}
